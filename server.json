{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.lofder/dsers-mcp-product",
  "title": "DSers MCP Product Import",
  "description": "AI-powered dropshipping: import products from AliExpress/Alibaba/Accio to Shopify & Wix via DSers",
  "repository": {
    "url": "https://github.com/lofder/dsers-mcp-product",
    "source": "github"
  },
  "version": "1.2.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@lofder/dsers-mcp-product",
      "version": "1.2.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "DSERS_ENV",
          "description": "API environment: production (default) or test",
          "isRequired": false,
          "format": "string"
        }
      ]
    }
  ]
}
