{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.lofder/dsers-mcp-product",
  "title": "DSers MCP Product Import",
  "description": "Automate AliExpress dropshipping import to Shopify via DSers. Bulk import, pricing, multi-store.",
  "repository": {
    "url": "https://github.com/lofder/dsers-mcp-product",
    "source": "github"
  },
  "version": "1.0.2",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@lofder/dsers-mcp-product",
      "version": "1.0.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "DSERS_EMAIL",
          "description": "DSers account email",
          "isRequired": true,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "DSERS_PASSWORD",
          "description": "DSers account password",
          "isRequired": true,
          "format": "string",
          "isSecret": true
        }
      ]
    }
  ]
}
