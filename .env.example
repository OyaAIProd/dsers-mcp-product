# DSers account credentials
DSERS_EMAIL=your-dsers-email@example.com
DSERS_PASSWORD=your-dsers-password
DSERS_ENV=production

# Optional: override the DSers API base URL
# DSERS_BASE_URL=https://bff-api-gw.dsers.com

# Optional: override the job state directory
# IMPORT_MCP_STATE_DIR=.state

# Optional: override the session cache file path
# DSERS_SESSION_FILE=.session.json
